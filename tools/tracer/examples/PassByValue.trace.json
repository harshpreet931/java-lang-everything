  "source": "public class PassByValue {\n    static class Box {\n        int value;\n\n        Box(int value) {\n            this.value = value;\n        }\n    }\n\n    static void swap(int a, int b) {\n        int temp = a;\n        a = b;\n        b = temp;\n    }\n\n    static void fill(Box box) {\n        box.value = 99;\n    }\n\n    static void replace(Box box) {\n        box = new Box(-1);\n    }\n\n    public static void main(String[] args) {\n        int a = 1;\n        int b = 2;\n        swap(a, b);\n        System.out.println(a + \" \" + b);\n\n        Box box = new Box(7);\n        fill(box);\n        replace(box);\n        System.out.println(box.value);\n    }\n}\n",
