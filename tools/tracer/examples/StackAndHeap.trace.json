  "source": "public class StackAndHeap {\n    static class Point {\n        int x;\n        int y;\n\n        Point(int x, int y) {\n            this.x = x;\n            this.y = y;\n        }\n    }\n\n    static void moveRight(Point p, int dx) {\n        p.x = p.x + dx;\n    }\n\n    public static void main(String[] args) {\n        int count = 3;\n        double ratio = 1.5;\n        String name = \"origin\";\n        int[] scores = {90, 75, 60};\n        Point p = new Point(1, 2);\n        moveRight(p, count);\n        System.out.println(name + \" moved to \" + p.x);\n        p = new Point(10, 20);\n        scores[0] = 100;\n        System.out.println(\"done\");\n    }\n}\n",
